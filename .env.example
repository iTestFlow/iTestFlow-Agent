# Database
DATABASE_URL=postgresql://itestflow:itestflow@localhost:5432/itestflow
DATABASE_POOL_MAX=10

# Database integration tests always use this dedicated, disposable database.
# Start it with: docker compose --profile test up -d postgres-test
# Then run: npm run db:migrate:test
TEST_DATABASE_URL=postgresql://itestflow:itestflow@localhost:5433/itestflow_test

# Auth and bootstrap
# SESSION_SECRET is optional/reserved (cookie HMAC hardening); sessions are stateful
# and do not require it today.
SESSION_SECRET=

# Bootstrap seeds the enabled Azure org(s) + owner(s) on startup. Pick the mode you need.
# In both, the owner email must match that org's Azure unique name/UPN so the seeded
# owner is recognized on first PAT login. Bootstrap is ADDITIVE — removing an org here
# does NOT remove it; disable one with:  npm run org:disable -- <orgUrlOrName>
# (re-enable with org:enable).
#
# Single-org setup — one org with one owner:
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_AZURE_ORG=
#
# Multi-org setup — several orgs, EACH with its own owner. Comma-separated
# "orgUrlOrName|ownerEmail" entries; when set, this takes precedence. An entry may omit
# "|email" to inherit BOOTSTRAP_OWNER_EMAIL above. Example:
#   BOOTSTRAP_AZURE_ORGS=https://dev.azure.com/org-a|admin@company.com, https://dev.azure.com/org-b|owner-b@company.com
BOOTSTRAP_AZURE_ORGS=

# Fresh Jira Cloud deployments must set BOOTSTRAP_JIRA_SITES with an owner email —
# the login page accepts only configured sites, and sign-in uses each user's own
# Atlassian account email + API token (no OAuth app, callback URL, or public
# origin is needed). Bootstrap is optional only for an upgrade whose database
# already carries an active jira-cloud workspace from an earlier seed.
# Jira Cloud bootstrap — the Jira mirror of the Azure entries above. Sites accept
# "mysite" or https://mysite.atlassian.net; each entry may carry its own owner via
# "siteUrl|ownerEmail" (omit "|email" to inherit BOOTSTRAP_OWNER_EMAIL). The owner
# email must match the owner's Atlassian account email — it is literally the email
# that owner types at login — so the seeded owner is recognized on their first
# token login. Seeded sites appear in the login site picker; the site's cloud ID
# is discovered and pinned on the first successful login. Example:
#   BOOTSTRAP_JIRA_SITES=mysite|admin@company.com, other.atlassian.net|owner-b@company.com
# For a same-cloud-ID URL rename, replace the old BOOTSTRAP_JIRA_SITES entry before
# restarting; do not list both URLs. The next successful login reconciles the placeholder.
# Legacy single-site compatibility only; prefer BOOTSTRAP_JIRA_SITES.
BOOTSTRAP_OWNER_JIRA_SITE=
BOOTSTRAP_JIRA_SITES=

# Which sign-in providers the login page offers, comma-separated
# ("azure-devops", "jira-cloud"). Unset = auto-detect: Azure DevOps always,
# Jira Cloud when BOOTSTRAP_JIRA_SITES (or the legacy pair) resolves at least
# one site, or the database already has an active jira-cloud workspace. The
# first listed provider is the login page's default pane; a Jira-only value
# shows the Jira form directly with a single configured site pre-selected.
# Explicitly enabling jira-cloud with no configured site refuses to start.
# Example: azure-devops,jira-cloud
BOOTSTRAP_ENABLED_PROVIDERS=

# Optional Atlassian OAuth sign-in (3LO) beside API tokens. Register the app in
# the Atlassian developer console with the callback /api/auth/jira/callback and
# the offline_access, read:me, read:jira-work, write:jira-work, read:jira-user
# scopes. Set all three variables or none. A callback URL alone is ignored for
# compatibility with older Azure-only templates. Once either client credential
# is supplied, a partial set refuses to start.
# The redirect URI only needs browser reachability (localhost works in dev).
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=
# Which Jira sign-in methods the login page offers: api_token, oauth, or both
# (comma-separated; order = display order). Unset auto-detects: api_token
# always, plus oauth when the OAuth client is configured. "oauth" alone is the
# OAuth-only mode for orgs whose Atlassian policy blocks API tokens.
JIRA_LOGIN_METHODS=

# Credential encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
CREDENTIAL_STALE_DAYS=60

# Background worker
# Run with `npm run worker` in production, or `npm run worker:dev` locally.
WORKER_SCHEDULER=
WORKER_SCHEDULER_TICK_MS=60000
WORKER_POLL_MS=2000
WORKER_HEARTBEAT_MS=30000
JOB_STALE_LOCK_MS=300000
# Uploaded documents are handled on a dedicated bounded worker lane. Binaries are
# stored outside PostgreSQL under this root, addressed by their SHA-256 digest.
WORKER_DOCUMENT_INGEST_CONCURRENCY=2
DOCUMENT_STORAGE_ROOT=data/document-store
DOCUMENT_MAX_UPLOAD_BYTES=52428800
# Local OCR rejects images above this decoded pixel count and regions below this
# confidence score. English and Arabic model data is bundled and verified locally.
OCR_MAX_IMAGE_PIXELS=40000000
OCR_MIN_CONFIDENCE=50
OCR_RECOGNIZE_TIMEOUT_MS=120000

# Deployment-managed command used only when a workspace selects the stdio
# Playwright MCP transport. The UI cannot supply or override these values.
PLAYWRIGHT_MCP_STDIO_COMMAND=
PLAYWRIGHT_MCP_STDIO_ARGS=[]
# Default enforcement. Stdio spawn strips sandbox-disable/conflicting args,
# --config/-c, and PLAYWRIGHT_MCP_NO_SANDBOX, then adds exactly one --sandbox.
# Set exactly true only when a constrained deployment deliberately needs to
# preserve its sandbox override from deployment args or parent environment.
PLAYWRIGHT_MCP_ALLOW_NO_SANDBOX=
# Production requires this exact true value in addition to the development override.
PLAYWRIGHT_MCP_ALLOW_NO_SANDBOX_IN_PRODUCTION=
# Comma-separated exact origins allowed for remote MCP endpoints and artifact bases.
# HTTP MCP cannot set remote Chrome flags; the remote server must not enable
# --no-sandbox unless authorized the same way.
PLAYWRIGHT_MCP_HTTP_ALLOWED_ORIGINS=
# Which websites the AI test browser may open during execution runs. Test cases
# can only navigate to origins on this list — anything else is blocked for safety.
# Use comma-separated exact origins (scheme + host + optional port, no path), e.g.:
#   PLAYWRIGHT_EXECUTION_ALLOWED_ORIGINS=https://staging.example.com,https://www.automationexercise.com
# Set to "*" to allow every origin (removes the safety boundary; deployment
# operator opt-in only). Restart the app after changing this value.
PLAYWRIGHT_EXECUTION_ALLOWED_ORIGINS=
PLAYWRIGHT_EXECUTION_UPLOAD_ROOTS=[]

# Rate limiting
# Backend defaults to "postgres" when NODE_ENV=production (shared limit across web
# replicas) and "memory" otherwise. Set explicitly to "postgres" or "memory" to override.
RATE_LIMIT_BACKEND=
# Number of trusted reverse proxies / load balancers in front of the app. The client
# IP for login throttling is read this many hops from the right of X-Forwarded-For,
# so a client cannot dodge its bucket by prepending fake IPs. 0 = take the nearest
# proxy's reported IP (rightmost entry). Set to your real proxy depth.
RATE_LIMIT_TRUSTED_PROXY_HOPS=0

# Deployment defaults (workspace settings override these where applicable)
PROJECT_CONTEXT_TOP_K=8
LLM_MAX_OUTPUT_TOKEN_CAP=32000
