{
  "mcpServers": {
    "chaosengine-memory": {
      "args": [
        "-3",
        ".chaos-engine/tool.py",
        "memory-mcp"
      ],
      "command": "py",
      "cwd": "."
    },
    "chaosengine-mempalace": {
      "args": [
        "-3",
        ".chaos-engine/tool.py",
        "mempalace-mcp",
        "--palace",
        ".chaos-engine-state/mempalace",
        "--backend",
        "sqlite_exact"
      ],
      "command": "py",
      "cwd": ".",
      "env": {
        "MEMPALACE_EMBEDDING_MODEL": "minilm"
      }
    },
    "itestflow-memory": {
      "args": [
        "--yes",
        "--package",
        "@aictx/memory@0.1.55",
        "--",
        "memory-mcp"
      ],
      "command": "npx",
      "cwd": "."
    },
    "itestflow-mempalace": {
      "args": [
        "--from",
        "mempalace==3.7.0",
        "mempalace-mcp",
        "--palace",
        ".mempalace/palace"
      ],
      "command": "uvx",
      "cwd": ".",
      "env": {
        "MEMPALACE_EMBEDDING_MODEL": "minilm"
      }
    }
  }
}
